{
  "servers": {
    "nzua": {
      "type": "stdio",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/NzuaMcp.csproj"],
      "env": {
        "NZUA_ALLOW_WRITES": "false",
        "NZUA_SHOW_REAL_NAMES": "false",
        "NZUA_HEADLESS": "true"
      }
    }
  }
}
